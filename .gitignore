# ---- dependencies ----
node_modules/
.pnpm-store/

# ---- build output that is not shipped ----
*.tsbuildinfo

# ---- headless-browser test scaffolding ----
# Disposable Edge/Chrome profiles: regenerated per run, ~50 MB each.
tools/browser-test/.profiles/
tools/browser-test/variants/
# Driver output (screenshots, JSON dumps). Regenerated by every run, so it is
# not source; the curated before/after images live in dsh-live2d-pet/docs/.
tools/browser-test/shots/

# ---- OS / editor noise ----
Thumbs.db
desktop.ini
.DS_Store
*.swp
.idea/
.vscode/

# ---- secrets ----
.env
.env.*
*.pem
*.key

# ---- local scratch (kept on disk, not published) ----
local-assets/

# ---- 命令输出的临时文件（commit message draft、driver 输出重定向）----
# 曾经把 .commitmsg.tmp 一起提交进去过：写文件、git add -A、再删，顺序错了就会中招。
.commitmsg.tmp
out.txt
push.out
push.err

# ---- proprietary runtime ----
# Live2D Cubism Core must be obtained from Live2D Inc. by the user.
# It is NOT redistributable, so it never enters this repository.
live2dcubismcore.min.js
