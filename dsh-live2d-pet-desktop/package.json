{
  "name": "dsh-pet-live2d-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Live2D 桌宠的桌面端：单文件便携 exe（Tauri 壳 + 内嵌 sidecar），复用 dsh-live2d-pet 的宿主/浏览器半区",
  "type": "module",
  "scripts": {
    "vendor": "node tools/vendor-react.mjs",
    "prep": "node tools/prep-embed.mjs",
    "icon": "node tools/make-icon.mjs",
    "sidecar": "node sidecar/server.mjs --page pet --port 8791",
    "spike": "node sidecar/server.mjs --page spike --port 8792",
    "ping": "node tools/ping.mjs",
    "dev": "cargo run --manifest-path src-tauri/Cargo.toml -- --page pet",
    "dev:spike": "cargo run --manifest-path src-tauri/Cargo.toml -- --page spike",
    "build:sidecar": "node tools/build-sidecar.mjs",
    "build:portable": "node tools/build-portable.mjs",
    "verify:shell": "node tools/desktop-driver.mjs --page pet",
    "verify:page": "node tools/page-driver.mjs --page pet",
    "verify:settings": "node tools/probe-settings.mjs",
    "verify:phase": "node tools/probe-phase.mjs --seconds 20",
    "verify:anim": "node tools/probe-anim.mjs --ms 4000"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
